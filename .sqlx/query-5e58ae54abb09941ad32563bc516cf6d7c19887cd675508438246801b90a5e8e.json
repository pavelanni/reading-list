  "query": "SELECT a.id AS \"id!\", a.url, a.title, a.saved_at,\n                      sa.added_text AS \"added_text?\", sa.created_at AS \"added_at?\"\n               FROM article a\n               LEFT JOIN story_addition sa ON sa.article_id = a.id\n               WHERE a.story_id = ?\n               ORDER BY a.saved_at, a.id",
